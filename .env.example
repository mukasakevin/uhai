# Variables d'environnement — Centre UHAI
# Copier ce fichier en .env et remplir les vraies valeurs

# Port du serveur (défaut : 3000)
PORT=3005

# Chemin vers la base SQLite (relatif à la racine du projet)
DB_PATH=data/uhai.db

# Mot de passe administrateur (CHANGER ABSOLUMENT en production)
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE
